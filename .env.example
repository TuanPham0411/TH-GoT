BIND_ADDRESS=127.0.0.1
PORT=5082
PUBLIC_URL=http://localhost:5082
# Required before users can sign in and open sessions.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to PUBLIC_URL + /auth/callback.
GOOGLE_REDIRECT_URI=
# Empty generates a private persistent key in the /data volume.
FLASK_SECRET_KEY=
TRUST_PROXY=0
# Public Drive FILE share URL; overrides the default in assets.lock.json.
# May be left empty to use the pinned default or an existing offline cache.
# The archive SHA-256 and file inventory are pinned in assets.lock.json.
ASSETS_URL=https://drive.google.com/file/d/1JsQk7-4mWJlmCJDd5TdDy9mnUnEm41U5/view?usp=sharing
